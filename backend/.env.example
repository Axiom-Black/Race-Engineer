# ── Application ───────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
APP_SECRET_KEY=change-me-in-production

# ── Database ───────────────────────────────────────────────────────
# TimescaleDB-enabled Postgres (standard postgres:// URI)
DATABASE_URL=postgresql+asyncpg://bytecraft:bytecraft@localhost:5432/bytecraft_racing
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_ORCHESTRATOR=claude-sonnet-4-6
ANTHROPIC_MODEL_SPECIALIST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SYNTHESIZER=claude-sonnet-4-6

# ── Auth (Clerk) ──────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
