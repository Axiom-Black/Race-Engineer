# Copy to .env.local (gitignored) and fill in from the Supabase dashboard
# (project: bytecraft-racing). The publishable key is client-safe by design.
VITE_SUPABASE_URL=https://nunkznbcdxgsofqlogri.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OPTIONAL — error monitoring (Sentry free tier).
# Leave unset and monitoring is fully off: no SDK chunk is fetched, no network
# call, nothing initialised. The build does NOT require this (unlike the two
# Supabase vars above) — a missing DSN degrades observability, it does not
# break the product.
# The SDK is ~156 kB gzipped, so it loads as a lazy chunk only when set.
VITE_SENTRY_DSN=
